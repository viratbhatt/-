# SMTP (Nodemailer) settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM="Site Contact <no-reply@example.com>"
TO_EMAIL=you@example.com
EMAIL_SUBJECT_PREFIX=[Portfolio]

# Server port (optional)
PORT=5178

# Simple rate limiting (optional)
# how many submissions allowed per IP in the window
RATE_LIMIT_MAX=5
# window in seconds (default 3600 = 1 hour)
RATE_LIMIT_WINDOW_SEC=3600
